#!/usr/bin/env bash
# Local installation. Production ownership stays in Kubernetes.
# shellcheck disable=SC1091
set -Eeuo pipefail
umask 077
repo_root="$(cd "$(dirname "$0")" && pwd)"
source "$repo_root/demo-files/host.sh"
initialize_demo_host
if [[ -n "${DSH_RUNTIME_HOME:-}" && -n "${DSH_DEMO_HOME:-}" && "$DSH_RUNTIME_HOME" != "$DSH_DEMO_HOME" ]]; then
  echo 'DSH_RUNTIME_HOME and legacy DSH_DEMO_HOME disagree; no resources changed' >&2; exit 2
fi
export DSH_DEMO_HOME="${DSH_RUNTIME_HOME:-${DSH_DEMO_HOME:-}}"
if [[ "$demo_os" == darwin && -z "${XDG_STATE_HOME:-}" ]]; then
  demo_default="$HOME/Library/Application Support/DSH Isolated Runtime"
else demo_default="${XDG_STATE_HOME:-$HOME/.local/state}/dsh-isolated-runtime"; fi
demo_root="${DSH_DEMO_HOME:-$demo_default}"
mkdir -p "$demo_root"
demo_root="$(cd "$demo_root" && pwd)"
exec 9>"$demo_root/lock"
demo_lock acquire || { echo 'Another runtime command is running' >&2; exit 1; }
source "$repo_root/demo-files/tools.sh"
source "$repo_root/hack/lib/reference-versions.sh"
source "$repo_root/hack/lib/browser-stack.sh"
export DSH_LOCAL_RUNTIME=1
export PATH="$demo_root/tools/bin:$PATH"
kubeconfig="$demo_root/kubeconfig"
test_root="$demo_root/runtime"
mkdir -p "$test_root"
cluster_name="dsh-demo-$(printf '%s' "$demo_root" | sha256sum | cut -c1-10)"
dex_issuer="https://dex.dsh-system.svc:15556/dex"
dex_alice_sub="CglhbGljZS1zdWISBWxvY2Fs"
k() { kubectl --kubeconfig "$kubeconfig" "$@"; }
pull_image() {
  local requested="$1" resolved="$1"
  if [[ -f "$repo_root/runtime-files/images.lock.json" ]]; then
    resolved="$(jq -er --arg source "$requested" '.images[] | select(.source==$source) | .ref' "$repo_root/runtime-files/images.lock.json")" || {
      echo "Image is not in the release lock: $requested" >&2; return 1;
    }
  fi
  for attempt in $(seq 1 5); do
    if docker pull --platform "$demo_platform" "$resolved" >/dev/null; then
      if [[ "$requested" != *@* ]]; then docker tag "$resolved" "$requested"; fi
      return
    fi
    sleep "$attempt"
  done
  echo "Could not pull required image: $requested" >&2; return 1
}
diagnostics() {
  echo "Runtime operation failed. Private diagnostics: $test_root" >&2
  k get pods,cells,httproutes -A > "$test_root/objects.txt" 2>&1 || true
}
trap diagnostics ERR
owned_cluster() {
  [[ -f "$demo_root/owner" && -f "$kubeconfig" ]] || return 1
  [[ "$(docker inspect "${cluster_name}-control-plane" --format '{{ index .Config.Labels "io.x-k8s.kind.cluster" }}' 2>/dev/null)" == "$cluster_name" ]] || return 1
  [[ "$(cat "$demo_root/owner")" == "$cluster_name" ]]
}
stop_forwards() {
  local file
  for file in "$test_root/18443.pid" "$test_root/15556.pid"; do
    stop_demo_process "$file" 'port-forward' "--kubeconfig $kubeconfig"
  done
}
stop_browser() {
  stop_demo_process "$test_root/browser.pid" '/demo-files/open.cjs' "$demo_root"
}
start_forward() {
  local service="$1" port="$2" remote="$3"
  if (echo >"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then
    echo "Local port $port is occupied; stop its owner and retry" >&2; return 1
  fi
  nohup kubectl --kubeconfig "$kubeconfig" -n dsh-system port-forward --address 127.0.0.1 "service/$service" "$port:$remote" \
    >"$test_root/$port.log" 2>&1 < /dev/null 9>&- &
  record_demo_process "$test_root/$port.pid" "$!"
  for _ in $(seq 1 60); do
    (echo >"/dev/tcp/127.0.0.1/$port") 2>/dev/null && return
    sleep 1
  done
  echo "Port-forward $port did not become ready" >&2; return 1
}
forward_browser() {
  stop_forwards
  local service
  service="$(k -n dsh-system get service -l gateway.envoyproxy.io/owning-gateway-name=dsh -o jsonpath='{.items[0].metadata.name}')"
  start_forward "$service" 18443 443
  start_forward dex 15556 15556
}
case "${1:-help}" in
  help|--help|-h)
    printf 'dsh-runtime up [--snapshots]  Start/resume the local installation\ndsh-runtime open              Open the isolated browser\ndsh-runtime doctor [--json]   Check local prerequisites\ndsh-runtime status [--json]   Inspect the owned installation\ndsh-runtime credentials       Show the local login (private)\ndsh-runtime stop              Stop the cluster; preserve data\ndsh-runtime uninstall --yes   Delete the owned cluster AND data\n'
    ;;
  doctor)
    [[ $# == 1 || ($# == 2 && "$2" == --json) ]] || exit 2
    failures=0
    [[ "${2:-}" != --json ]] || printf '{"schemaVersion":1,"checks":['
    separator=''
    for required in bash curl tar openssl git; do
      ok=true; command -v "$required" >/dev/null || { ok=false; failures=1; }
      if [[ "${2:-}" == --json ]]; then printf '%s{"name":"%s","ok":%s}' "$separator" "$required" "$ok"; separator=',';
      else printf '%s: %s\n' "$required" "$ok"; fi
    done
    ok=true; require_demo_docker >/dev/null 2>&1 || { ok=false; failures=1; }
    if [[ "${2:-}" == --json ]]; then printf ',{"name":"native-docker","ok":%s}],"ok":%s}\n' "$ok" "$([[ $failures == 0 ]] && echo true || echo false)";
    else printf 'native-docker: %s\nReference allocation: 4 CPUs / 16 GiB RAM; internet access required.\n' "$ok"; fi
    exit "$failures"
    ;;
  status)
    [[ $# == 1 || ($# == 2 && "$2" == --json) ]] || exit 2
    state=not-installed; ready=false; code=0
    if [[ -f "$demo_root/owner" ]]; then
      if ! owned_cluster; then state=unavailable; code=1
      elif [[ "$(docker inspect "${cluster_name}-control-plane" --format '{{.State.Running}}')" != true ]]; then state=stopped
      elif k --request-timeout=10s -n tenant-demo get cell assistant -o json 2>/dev/null | jq -e '.status.observedGeneration==.metadata.generation and any(.status.conditions[]?; .type=="Ready" and .status=="True")' >/dev/null 2>&1; then state=running; ready=true
      else state=starting-or-unhealthy; code=1; fi
    fi
    if [[ "${2:-}" == --json ]]; then printf '{"schemaVersion":1,"state":"%s","ready":%s}\n' "$state" "$ready";
    else printf 'State: %s\nCell ready: %s\nState directory: %s\n' "$state" "$ready" "$demo_root"; fi
    exit "$code"
    ;;
  credentials)
    [[ $# == 1 ]] || exit 2
    [[ -f "$demo_root/credentials.json" ]] || { echo 'No local credentials; run up first' >&2; exit 1; }
    cat "$demo_root/credentials.json"
    ;;
  stop)
    [[ $# == 1 ]] || exit 2
    [[ -f "$demo_root/owner" ]] || { echo 'No local installation; nothing stopped'; exit 0; }
    owned_cluster || { echo 'Cannot verify ownership; nothing stopped' >&2; exit 1; }
    stop_browser
    stop_forwards
    docker stop "${cluster_name}-control-plane" >/dev/null
    echo 'Local cluster stopped; data retained. Run dsh-runtime up to resume.'
    ;;
  up)
    [[ $# == 1 || ($# == 2 && "$2" == --snapshots) ]] || { echo 'usage: dsh-runtime up [--snapshots]' >&2; exit 2; }
    require_demo_docker
    prepare_demo_tools
    [[ -f "$repo_root/release.json" ]] || { echo 'Use the release bundle, which includes release.json with tested image digests' >&2; exit 1; }
    [[ "$(jq -r .platform "$repo_root/release.json")" == "$demo_platform" ]] || { echo "This bundle does not target $demo_platform; download the archive for this architecture" >&2; exit 1; }
    cell_image="$(jq -er .images.cell "$repo_root/release.json")"
    operator_image="$(jq -er .images.operator "$repo_root/release.json")"
    [[ "$cell_image" =~ @sha256:[a-f0-9]{64}$ && "$operator_image" =~ @sha256:[a-f0-9]{64}$ ]]
    if kind get clusters 2>/dev/null | grep -Fxq "$cluster_name"; then
      owned_cluster || { echo 'Existing cluster has no matching ownership record' >&2; exit 1; }
      [[ "$(cat "$demo_root/release-sha")" == "$(jq -r .sourceSHA "$repo_root/release.json")" ]] || { echo 'Existing installation uses a different release; preserve/export data before explicit uninstall' >&2; exit 1; }
      if [[ "$(docker inspect "${cluster_name}-control-plane" --format '{{.State.Running}}')" != true ]]; then
        docker start "${cluster_name}-control-plane" >/dev/null
        for _ in $(seq 1 120); do k --request-timeout=5s get nodes >/dev/null 2>&1 && break; sleep 2; done
        k wait node --all --for=condition=Ready --timeout=180s
      fi
      if [[ "${2:-}" == --snapshots && ! -f "$test_root/snapshots-ready" ]] && k -n tenant-demo get cell assistant >/dev/null 2>&1; then
        echo 'Choose --snapshots before creating the Cell; its StorageClass cannot change in place' >&2; exit 1
      fi
    else
      for port in 18443 15556; do
        if (echo >"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then echo "Local port $port is occupied" >&2; exit 1; fi
      done
      cat > "$test_root/kind.yaml" <<'YAML'
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
networking:
  disableDefaultCNI: true
  podSubnet: 192.168.0.0/16
nodes:
  - role: control-plane
YAML
      printf '%s\n' "$cluster_name" > "$demo_root/owner"
      jq -r .sourceSHA "$repo_root/release.json" > "$demo_root/release-sha"
      kind create cluster --name "$cluster_name" --kubeconfig "$kubeconfig" --config "$test_root/kind.yaml" \
        --image kindest/node:v1.34.0@sha256:7416a61b42b1662ca6ca89f02028ac133a309a2a30ba309614e8ec94d976dc5a
    fi
    [[ -f "$repo_root/runtime-files/images.lock.json" ]] || { echo 'Release is missing its runtime image lock' >&2; exit 1; }
    # Completion markers make an interrupted up resumable without reissuing TLS
    # keys or replacing a user's populated Cell.
    if [[ ! -f "$test_root/network-ready" ]]; then
      install_reference_network
      touch "$test_root/network-ready"
    fi
    if [[ ! -f "$test_root/identity-ready" ]]; then
      mkdir -p "$demo_root/identity"
      cp "$repo_root/runtime-files/package"*.json "$demo_root/identity/"
      (cd "$demo_root/identity" && npm ci --ignore-scripts --no-audit --no-fund)
      node "$repo_root/runtime-files/identity.cjs" prepare "$demo_root"
      export DSH_LOCAL_IDENTITY_ROOT="$demo_root"
      install_reference_identity
      touch "$test_root/identity-ready"
    fi
    if [[ ! -f "$test_root/access-ready" ]]; then
      kubectl kustomize "$repo_root/config/browser" > "$test_root/browser.yaml"
      k apply -f "$test_root/browser.yaml"
      node "$repo_root/demo-files/configure.mjs" "$operator_image" "$dex_issuer" "$test_root"
      k -n dsh-system patch deployment cell-operator --type=strategic --patch-file "$test_root/operator.json"
      k -n dsh-system patch deployment cell-authorizer --type=strategic --patch-file "$test_root/authorizer.json"
      configure_reference_access
      touch "$test_root/access-ready"
    fi
    if [[ "${2:-}" == --snapshots || -f "$test_root/snapshots-ready" ]]; then
      if [[ ! -f "$test_root/snapshots-ready" ]]; then
        source "$repo_root/hack/lib/snapshot-stack.sh"
        k -n dsh-system patch deployment cell-operator --type=json \
          -p '[{"op":"add","path":"/spec/template/spec/containers/0/args/-","value":"--enable-snapshots=true"}]'
        touch "$test_root/snapshots-ready"
      fi
      storage_class=csi-hostpath-sc
    else
      storage_class=standard
    fi
    k create namespace tenant-demo --dry-run=client -o yaml | k apply -f -
    k label namespace tenant-demo dsh.isolated.io/routes=enabled --overwrite
    if ! k -n tenant-demo get cell assistant >/dev/null 2>&1; then
      jq -n --arg image "$cell_image" --arg sc "$storage_class" \
        '{apiVersion:"dsh.isolated.io/v1alpha1",kind:"Cell",metadata:{name:"assistant",namespace:"tenant-demo"},spec:{image:$image,storage:{size:"1Gi",storageClassName:$sc,retentionPolicy:"Retain"}}}' | k apply -f -
    fi
    k -n tenant-demo wait cell assistant --for=condition=Ready --timeout=300s
    uid="$(k -n tenant-demo get cell assistant -o jsonpath='{.metadata.uid}')"
    k -n tenant-demo create rolebinding demo-access --role="cell-$uid-access" --user="$dex_issuer#$dex_alice_sub" --dry-run=client -o yaml | k apply -f -
    k -n tenant-demo get httproute "cell-$uid" -o jsonpath='{.spec.hostnames[0]}' > "$test_root/hostname"
    forward_browser
    printf 'Ready: https://%s:18443\nLocal login: ./dsh-runtime credentials (keep private)\nOpen: ./dsh-runtime open\nKubeconfig: %s\n' "$(cat "$test_root/hostname")" "$kubeconfig"
    ;;
  open)
    [[ $# == 1 ]] || exit 2
    owned_cluster || { echo 'Run dsh-runtime up first' >&2; exit 1; }
    [[ "$demo_os" == darwin || -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] || { echo 'A graphical session is required for open; use the headless acceptance runner in CI.' >&2; exit 1; }
    prepare_demo_tools
    forward_browser
    mkdir -p "$demo_root/browser"
    cp "$repo_root/test/e2e/phase2/package"*.json "$demo_root/browser/"
    # npm --prefix misidentifies a project under macOS /var -> /private/var.
    (cd "$demo_root/browser" && npm ci --ignore-scripts --no-audit --no-fund)
    export PLAYWRIGHT_BROWSERS_PATH="$demo_root/browser/browsers"
    if [[ -z "${CHROME_EXECUTABLE:-}" ]]; then
      node "$demo_root/browser/node_modules/playwright/cli.js" install chromium
    fi
    demo_lock release
    DSH_DEMO_HOME="$demo_root" node "$repo_root/demo-files/open.cjs" "$demo_root"
    ;;
  uninstall)
    [[ $# == 2 && "$2" == --yes ]] || { echo 'This deletes the local cluster and ALL its data. Use uninstall --yes only after explicit confirmation.' >&2; exit 2; }
    [[ -f "$demo_root/owner" ]] || { echo 'No ownership record; nothing removed'; exit 0; }
    owned_cluster || { echo 'Cannot verify ownership; no resources removed' >&2; exit 1; }
    stop_browser
    stop_forwards
    kind delete cluster --name "$cluster_name"
    rm -rf "$test_root" "$demo_root/browser/profile"
    rm -f "$demo_root/owner" "$demo_root/kubeconfig" "$demo_root/release-sha"
    rm -f "$demo_root/credentials.json" "$demo_root/identity/client-secret"
    echo 'Local cluster and its data deleted; downloaded tools retained.'
    ;;
  *) echo 'Unknown command; use dsh-runtime --help' >&2; exit 2 ;;
esac
