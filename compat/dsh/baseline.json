    "integrity": "sha512-EAJ3gPNcVt/uv8X19PMm9NkVhWgT7xXNMk0UKCVm+IQ5rpSQOcsMUa0HWlnYYVybKMsccjcRB21vVVsaXQ6IdA==",
    "lockfile": "images/environment/package-lock.json",
    "settingsPatch": {
      "file": "node_modules/@deepseek-ai/dsh-client-ui-settings/lib/client.js",
      "beforeSHA256": "2ac7f186165c5a8ec2cd90045cf74693e5d3518ec90cd429951360d79754aa94",
      "afterSHA256": "1be776deb3d9707472770e23fc03c720bf78432ea602bbe93c95dafe03365e43",
      "reason": "Real Chromium at environment.test: Models fails with settings are unavailable in this browser; no native persistence option exists"
    }
  },
  "transport": {
    "unaryPrefix": "/api/",
    "remoteMux": "/api/remote.mux",
    "launchTokenLocation": "process-memory-and-readiness-url",
    "cookieAuthorityBound": true,
    "standardCLIListen": "127.0.0.1"
  },
  "shutdown": {
    "signal": "SIGTERM",
    "exitCode": 0,
    "flushAcknowledgement": false,
    "reason": "exit alone is not a durable flush acknowledgement"
  },
  "state": {
    "workspace": "/var/lib/dsh/data/workspace",
    "home": "/var/lib/dsh/data/home",
    "dshHome": "/var/lib/dsh/data/dsh",
    "credentials": "$DSH_HOME/.credentials.yaml",
    "cache": "/tmp/.cache"
  },
  "constraints": [
    "No previous session version migration acceptance",
    "No source rebuild or upstream fork",
    "Models settings patch only in the authenticated per-user image; launcher/proxy authentication is unchanged"
  ]
}
