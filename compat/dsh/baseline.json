{
  "schemaVersion": 3,
  "source": {
    "repository": "https://github.com/deepseek-ai/deepseek-harness.git",
    "tag": "dsh-v0.2.1-rc.5",
    "commit": "b830ec950faba0a46dda564be3e2d854afed94f1",
    "version": "0.2.1-rc.5"
  },
  "distribution": {
    "mode": "npm",
    "package": "@deepseek-ai/dsh",
    "version": "0.2.1-rc.5",
    "integrity": "sha512-WkyJZv4zl9sCAxSzRctGm58m0rilGqwR6pniBiLOz5CPDfHfDuAUicg0AAazXI7oj/Cph6/cjNTncA/rpLTXpw==",
    "lockfile": "images/environment/package-lock.json"
  },
  "transport": {
    "unaryPrefix": "/api/",
    "remoteMux": "/api/remote.mux",
    "launchTokenLocation": "process-memory-and-readiness-url",
    "cookieAuthorityBound": true,
    "standardCLIListen": "127.0.0.1"
  },
  "shutdown": {
    "signal": "SIGTERM",
    "exitCode": 0,
    "flushAcknowledgement": false,
    "reason": "exit alone is not a durable flush acknowledgement"
  },
  "state": {
    "workspace": "/var/lib/dsh/data/workspace",
    "home": "/var/lib/dsh/data/home",
    "dshHome": "/var/lib/dsh/data/dsh",
    "credentials": "$DSH_HOME/.credentials.yaml",
    "cache": "/tmp/.cache"
  },
  "constraints": [
    "No previous session version migration acceptance",
    "No source rebuild or upstream fork",
    "Native authenticated-browser settings persistence; no settings client patch"
  ]
}
