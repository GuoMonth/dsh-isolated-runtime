{
  "name": "dsh-isolated-runtime-root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": "^24.22.3 || >=26.13.1"
  },
  "scripts": {
    "build": "pnpm --filter @dsh/environment-connector-internal build",
    "typecheck": "tsc --noEmit && pnpm --filter @dsh/environment-connector-internal typecheck",
    "test": "pnpm --filter @dsh/environment-connector-internal test",
    "security": "node --test hack/audit-node.test.ts && node hack/audit-node.ts",
    "fmt": "node hack/format.ts",
    "fmt:check": "oxlint --config .oxlintrc.format.json --deny-warnings",
    "lint": "node hack/lint.ts",
    "lint:raw": "oxlint --format json",
    "test:tooling": "node --test hack/lint.test.ts"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "22.20.1",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
